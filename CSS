/* =========================
   GENERAL SETTINGS
========================= */

* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
    scroll-behavior: smooth;
}

body {
    background: #080810;
    color: white;
    font-family: "Poppins", sans-serif;
    overflow-x: hidden;
}

a {
    text-decoration: none;
    color: white;
}

span {
    color: #00f7ff;
}


/* =========================
   NAVBAR
========================= */

.navbar {
    width: 100%;
    height: 80px;
    display: flex;
    align-items: center;
    justify-content: space-between;

    padding: 0 7%;

    position: fixed;
    top: 0;
    left: 0;

    background: rgba(8, 8, 16, 0.85);
    backdrop-filter: blur(15px);

    border-bottom: 1px solid rgba(0, 247, 255, 0.15);

    z-index: 1000;
}

.logo,
.footer-logo {
    font-family: "Orbitron", sans-serif;
    font-size: 25px;
    font-weight: 900;
    letter-spacing: 2px;
}

.logo span,
.footer-logo span {
    color: #00f7ff;
}

.navbar nav {
    display: flex;
    gap: 30px;
}

.navbar nav a {
    font-size: 14px;
    transition: 0.3s;
}

.navbar nav a:hover {
    color: #00f7ff;
}

.nav-button {
    padding: 12px 22px;

    background: #00f7ff;
    color: #05050a;

    font-weight: 700;
    font-size: 13px;

    clip-path: polygon(
        8% 0,
        100% 0,
        92% 100%,
        0 100%
    );

    transition: 0.3s;
}

.nav-button:hover {
    box-shadow: 0 0 25px #00f7ff;
}


/* =========================
   HERO
========================= */

.hero {
    min-height: 100vh;

    display: flex;
    align-items: center;
    justify-content: space-between;

    padding: 130px 8% 80px;

    background:
        radial-gradient(
            circle at 80% 50%,
            rgba(0, 247, 255, 0.15),
            transparent 35%
        ),
        radial-gradient(
            circle at 20% 30%,
            rgba(150, 0, 255, 0.12),
            transparent 30%
        );
}

.hero-content {
    max-width: 650px;
}

.small-title {
    color: #00f7ff;
    font-size: 13px;
    letter-spacing: 4px;
    margin-bottom: 20px;
    font-weight: 600;
}

.hero h1 {
    font-family: "Orbitron", sans-serif;

    font-size: clamp(45px, 7vw, 90px);

    line-height: 1.05;

    margin-bottom: 25px;
}

.hero h1 span {
    display: block;

    background: linear-gradient(
        90deg,
        #00f7ff,
        #8a2be2
    );

.gradient-text {
    background: linear-gradient(90deg, #00ffff, #8a2be2);
    background-clip: text;
    -webkit-background-clip: text;
    color: transparent;
}
}

.hero-text {
    color: #a5a5b4;
    max-width: 550px;
    line-height: 1.8;
}

.hero-buttons {
    display: flex;
    gap: 20px;
    margin-top: 35px;
}

.main-button,
.secondary-button {
    display: inline-block;

    padding: 15px 28px;

    font-weight: 700;
    font-size: 13px;

    transition: 0.3s;
}

.main-button {
    background: #00f7ff;
    color: #05050a;

    clip-path: polygon(
        8% 0,
        100% 0,
        92% 100%,
        0 100%
    );
}

.main-button:hover {
    transform: translateY(-5px);
    box-shadow: 0 0 30px rgba(0, 247, 255, 0.6);
}

.secondary-button {
    border: 1px solid #00f7ff;
    color: #00f7ff;
}

.secondary-button:hover {
    background: #00f7ff;
    color: #05050a;
}

.hero-stats {
    display: flex;
    gap: 50px;
    margin-top: 50px;
}

.hero-stats h3 {
    font-family: "Orbitron", sans-serif;
    color: #00f7ff;
    font-size: 25px;
}

.hero-stats p {
    color: #777789;
    font-size: 12px;
}


/* =========================
   HERO GRAPHIC
========================= */

.hero-image {
    width: 40%;
    height: 500px;

    position: relative;

    display: flex;
    align-items: center;
    justify-content: center;
}

.circle {
    width: 380px;
    height: 380px;

    border-radius: 50%;

    border: 2px solid rgba(0, 247, 255, 0.4);

    box-shadow:
        0 0 40px rgba(0, 247, 255, 0.25),
        inset 0 0 50px rgba(0, 247, 255, 0.15);

    animation: pulse 3s infinite;
}

.controller {
    position: absolute;

    font-size: 180px;

    filter:
        drop-shadow(0 0 15px #00f7ff)
        drop-shadow(0 0 40px #00f7ff);

    animation: floating 4s ease-in-out infinite;
}

.floating-card {
    position: absolute;

    padding: 12px 20px;

    background: rgba(20, 20, 35, 0.9);

    border: 1px solid #00f7ff;

    color: #00f7ff;

    font-family: "Orbitron", sans-serif;

    font-size: 11px;

    box-shadow: 0 0 20px rgba(0, 247, 255, 0.2);
}

.card-one {
    top: 80px;
    right: 10px;
}

.card-two {
    bottom: 100px;
    left: 0;
}

@keyframes floating {

    0%,
    100% {
        transform: translateY(0);
    }

    50% {
        transform: translateY(-20px);
    }
}

@keyframes pulse {

    0%,
    100% {
        transform: scale(1);
    }

    50% {
        transform: scale(1.05);
    }
}


/* =========================
   SECTIONS
========================= */

.games-section,
.categories,
.community,
.membership {
    padding: 100px 8%;
}

.section-heading {
    text-align: center;
    margin-bottom: 60px;
}

.section-heading p {
    color: #00f7ff;
    font-size: 12px;
    letter-spacing: 4px;
    margin-bottom: 15px;
}

.section-heading h2 {
    font-family: "Orbitron", sans-serif;
    font-size: 40px;
}


/* =========================
   GAME CARDS
========================= */

.game-grid {
    display: grid;

    grid-template-columns:
        repeat(4, 1fr);

    gap: 25px;
}

.game-card {
    background: #11111c;

    border: 1px solid #202033;

    transition: 0.4s;

    overflow: hidden;
}

.game-card:hover {
    transform: translateY(-10px);

    border-color: #00f7ff;

    box-shadow:
        0 15px 40px rgba(0, 247, 255, 0.15);
}

.game-image {
    height: 220px;

    display: flex;
    align-items: flex-end;

    padding: 20px;

    position: relative;
}

.game-image span {
    background: #00f7ff;
    color: #05050a;

    padding: 6px 12px;

    font-size: 10px;
    font-weight: 700;
}

.game-one {
    background:
        linear-gradient(
            rgba(0,0,0,0.1),
            rgba(0,0,0,0.8)
        ),
        linear-gradient(
            135deg,
            #071b27,
            #005f73,
            #11111c
        );
}

.game-two {
    background:
        linear-gradient(
            rgba(0,0,0,0.1),
            rgba(0,0,0,0.8)
        ),
        linear-gradient(
            135deg,
            #28104e,
            #6a1b9a,
            #11111c
        );
}

.game-three {
    background:
        linear-gradient(
            rgba(0,0,0,0.1),
            rgba(0,0,0,0.8)
        ),
        linear-gradient(
            135deg,
            #40120a,
            #c62828,
            #11111c
        );
}

.game-four {
    background:
        linear-gradient(
            rgba(0,0,0,0.1),
            rgba(0,0,0,0.8)
        ),
        linear-gradient(
            135deg,
            #091329,
            #283593,
            #11111c
        );
}

.game-info {
    padding: 20px;
}

.game-info h3 {
    font-family: "Orbitron", sans-serif;
    font-size: 17px;
}

.game-info p {
    color: #777789;
    font-size: 12px;
    margin-top: 7px;
}

.game-bottom {
    display: flex;
    align-items: center;
    justify-content: space-between;

    margin-top: 20px;
}

.game-bottom span {
    font-size: 12px;
}

.game-bottom button {
    background: transparent;
    border: 1px solid #00f7ff;

    color: #00f7ff;

    padding: 7px 14px;

    cursor: pointer;

    transition: 0.3s;
}

.game-bottom button:hover {
    background: #00f7ff;
    color: #05050a;
}


/* =========================
   CATEGORIES
========================= */

.categories {
    background: #0d0d17;
}

.category-grid {
    display: grid;

    grid-template-columns:
        repeat(6, 1fr);

    gap: 20px;
}

.category-card {
    text-align: center;

    background: #11111c;

    border: 1px solid #202033;

    padding: 35px 15px;

    transition: 0.3s;
}

.category-card:hover {
    border-color: #00f7ff;
    transform: translateY(-8px);
}

.category-icon {
    font-size: 40px;
    margin-bottom: 20px;
}

.category-card h3 {
    font-family: "Orbitron", sans-serif;
    font-size: 14px;
}

.category-card p {
    color: #777789;
    font-size: 11px;
    margin-top: 8px;
}


/* =========================
   FEATURES
========================= */

.features {
    display: flex;

    justify-content: space-between;
    align-items: center;

    gap: 80px;

    padding: 120px 8%;
}

.feature-content {
    width: 55%;
}

.feature-content h2 {
    font-family: "Orbitron", sans-serif;

    font-size: 45px;

    margin-bottom: 25px;
}

.feature-content > p {
    color: #9999a8;

    line-height: 1.8;

    max-width: 650px;
}

.feature-list {
    margin-top: 35px;
}

.feature-item {
    display: flex;
    gap: 20px;

    margin-bottom: 25px;
}

.feature-item strong {
    width: 50px;
    height: 50px;

    display: flex;
    align-items: center;
    justify-content: center;

    background: rgba(0, 247, 255, 0.1);

    border: 1px solid #00f7ff;

    font-size: 20px;
}

.feature-item h3 {
    font-family: "Orbitron", sans-serif;
    font-size: 14px;
}

.feature-item p {
    color: #777789;
    font-size: 12px;
    margin-top: 5px;
}

.feature-box {
    width: 40%;

    min-height: 400px;

    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;

    text-align: center;

    background:
        linear-gradient(
            145deg,
            #101020,
            #17172b
        );

    border: 1px solid #00f7ff;

    box-shadow:
        0 0 60px rgba(0, 247, 255, 0.1);
}

.big-controller {
    font-size: 100px;

    margin-bottom: 20px;

    filter:
        drop-shadow(0 0 15px #00f7ff);
}

.feature-box h3 {
    font-family: "Orbitron", sans-serif;
    font-size: 25px;
}

.feature-box p {
    color: #777789;
    margin: 10px 0 25px;
}


/* =========================
   COMMUNITY
========================= */

.community {
    background: #0d0d17;
}

.community-content {
    display: grid;

    grid-template-columns:
        repeat(3, 1fr);

    gap: 25px;
}

.community-card {
    padding: 40px;

    background: #11111c;

    border-left: 3px solid #00f7ff;

    transition: 0.3s;
}

.community-card:hover {
    transform: translateY(-8px);
    background: #151526;
}

.community-number {
    font-family: "Orbitron", sans-serif;

    color: #00f7ff;

    font-size: 35px;

    margin-bottom: 25px;
}

.community-card h3 {
    font-family: "Orbitron", sans-serif;
    font-size: 18px;
}

.community-card p {
    color: #777789;

    line-height: 1.7;

    font-size: 13px;

    margin-top: 15px;
}


/* =========================
   MEMBERSHIP
========================= */

.pricing-grid {
    display: grid;

    grid-template-columns:
        repeat(3, 1fr);

    gap: 25px;

    max-width: 1100px;

    margin: auto;
}

.price-card {
    background: #11111c;

    border: 1px solid #25253a;

    padding: 40px;

    position: relative;

    transition: 0.3s;
}

.price-card:hover {
    transform: translateY(-10px);

    border-color: #00f7ff;
}

.price-card h3 {
    font-family: "Orbitron", sans-serif;

    font-size: 20px;

    margin-bottom: 20px;
}

.price {
    font-family: "Orbitron", sans-serif;

    color: #00f7ff;

    font-size: 35px;

    margin-bottom: 30px;
}

.price small {
    color: #777789;
    font-family: "Poppins", sans-serif;
    font-size: 11px;
}

.price-card ul {
    list-style: none;

    color: #aaaaba;

    font-size: 13px;

    line-height: 2.5;

    margin-bottom: 30px;
}

.price-button {
    display: block;

    text-align: center;

    border: 1px solid #00f7ff;

    color: #00f7ff;

    padding: 13px;

    font-size: 12px;

    font-weight: 700;

    transition: 0.3s;
}

.price-button:hover {
    background: #00f7ff;
    color: #05050a;
}

.popular {
    border-color: #00f7ff;

    box-shadow:
        0 0 40px rgba(0, 247, 255, 0.12);
}

.popular-label {
    position: absolute;

    top: 0;
    right: 0;

    background: #00f7ff;

    color: #05050a;

    padding: 7px 15px;

    font-size: 9px;

    font-weight: 800;
}


/* =========================
   CTA
========================= */

.cta {
    padding: 120px 8%;

    text-align: center;

    background:
        radial-gradient(
            circle,
            rgba(0, 247, 255, 0.12),
            transparent 50%
        );
}

.cta-content {
    max-width: 750px;

    margin: auto;
}

.cta-content > p:first-child {
    color: #00f7ff;

    font-size: 12px;

    letter-spacing: 4px;

    margin-bottom: 15px;
}

.cta h2 {
    font-family: "Orbitron", sans-serif;

    font-size: clamp(45px, 7vw, 75px);

    margin-bottom: 20px;
}

.cta h2 span {
    color: #00f7ff;
}

.cta-content > p {
    color: #888898;

    margin-bottom: 35px;
}


/* =========================
   FOOTER
========================= */

footer {
    padding: 60px 8% 30px;

    background: #050509;

    text-align: center;

    border-top: 1px solid #1b1b2a;
}

.footer-logo {
    margin-bottom: 15px;
}

footer > p {
    color: #666677;
    font-size: 12px;
}

.social-links {
    display: flex;

    justify-content: center;

    gap: 25px;

    margin: 25px 0;
}

.social-links a {
    color: #888898;

    font-size: 12px;

    transition: 0.3s;
}

.social-links a:hover {
    color: #00f7ff;
}

.copyright {
    padding-top: 25px;

    border-top: 1px solid #171722;
}


/* =========================
   RESPONSIVE DESIGN
========================= */

@media (max-width: 1100px) {

    .navbar nav {
        gap: 15px;
    }

    .game-grid {
        grid-template-columns: repeat(2, 1fr);
    }

    .category-grid {
        grid-template-columns: repeat(3, 1fr);
    }

    .hero-image {
        width: 45%;
    }

}


@media (max-width: 800px) {

    .navbar {
        height: auto;
        padding: 20px 6%;

        flex-wrap: wrap;

        gap: 20px;
    }

    .navbar nav {
        order: 3;

        width: 100%;

        justify-content: center;

        flex-wrap: wrap;
    }

    .hero {
        flex-direction: column;

        text-align: center;

        padding-top: 180px;
    }

    .hero-content {
        max-width: 100%;
    }

    .hero-buttons {
        justify-content: center;
    }

    .hero-stats {
        justify-content: center;
    }

    .hero-image {
        width: 100%;
        height: 400px;

        margin-top: 40px;
    }

    .features {
        flex-direction: column;
    }

    .feature-content,
    .feature-box {
        width: 100%;
    }

    .community-content,
    .pricing-grid {
        grid-template-columns: 1fr;
    }

}


@media (max-width: 600px) {

    .navbar {
        position: relative;
    }

    .navbar nav {
        display: none;
    }

    .nav-button {
        padding: 10px 15px;
    }

    .hero {
        padding-top: 80px;
    }

    .hero h1 {
        font-size: 45px;
    }

    .hero-buttons {
        flex-direction: column;
    }

    .hero-stats {
        gap: 20px;
    }

    .circle {
        width: 270px;
        height: 270px;
    }

    .controller {
        font-size: 120px;
    }

    .game-grid,
    .category-grid {
        grid-template-columns: 1fr;
    }

    .games-section,
    .categories,
    .community,
    .membership,
    .features {
        padding: 70px 6%;
    }

    .feature-content h2 {
        font-size: 35px;
    }

    .section-heading h2 {
        font-size: 30px;
    }

}