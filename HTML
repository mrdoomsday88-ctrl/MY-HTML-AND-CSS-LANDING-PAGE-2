<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>GameZone - Ultimate Gaming Experience</title>

    <!-- Google Font -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Orbitron:wght@400;500;600;700;800;900&family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">

    <!-- CSS -->
    <link rel="stylesheet" href="style.css">
</head>

<body>

    <!-- ================= NAVBAR ================= -->

    <header class="navbar">
        <div class="logo">
            <span>GAME</span>ZONE
        </div>

        <nav>
            <a href="#home">Home</a>
            <a href="#games">Games</a>
            <a href="#categories">Categories</a>
            <a href="#community">Community</a>
            <a href="#membership">Membership</a>
        </nav>

        <a href="#join" class="nav-button">PLAY NOW</a>
    </header>


    <!-- ================= HERO SECTION ================= -->

    <section class="hero" id="home">

        <div class="hero-content">

            <p class="small-title">WELCOME TO THE FUTURE OF GAMING</p>

            <h1>
                ENTER THE
                <span>GAME</span>
                UNIVERSE
            </h1>

            <p class="hero-text">
                Discover amazing worlds, battle legendary players,
                and experience gaming like never before.
            </p>

            <div class="hero-buttons">
                <a href="#games" class="main-button">EXPLORE GAMES</a>
                <a href="#community" class="secondary-button">JOIN COMMUNITY</a>
            </div>

            <div class="hero-stats">

                <div>
                    <h3>2.5M+</h3>
                    <p>Players</p>
                </div>

                <div>
                    <h3>500+</h3>
                    <p>Games</p>
                </div>

                <div>
                    <h3>150+</h3>
                    <p>Tournaments</p>
                </div>

            </div>

        </div>

        <div class="hero-image">

            <div class="circle"></div>

            <div class="controller">
                🎮
            </div>

            <div class="floating-card card-one">
                🔥 NEW GAME
            </div>

            <div class="floating-card card-two">
                🏆 #1 RANKED
            </div>

        </div>

    </section>


    <!-- ================= GAMES SECTION ================= -->

    <section class="games-section" id="games">

        <div class="section-heading">
            <p>DISCOVER YOUR NEXT ADVENTURE</p>
            <h2>FEATURED <span>GAMES</span></h2>
        </div>

        <div class="game-grid">

            <div class="game-card">

                <div class="game-image game-one">
                    <span>FPS</span>
                </div>

                <div class="game-info">
                    <h3>Cyber Assault</h3>
                    <p>Multiplayer • Action • FPS</p>

                    <div class="game-bottom">
                        <span>⭐ 4.9</span>
                        <button>PLAY</button>
                    </div>
                </div>

            </div>


            <div class="game-card">

                <div class="game-image game-two">
                    <span>RPG</span>
                </div>

                <div class="game-info">
                    <h3>Shadow Realms</h3>
                    <p>Fantasy • RPG • Adventure</p>

                    <div class="game-bottom">
                        <span>⭐ 4.8</span>
                        <button>PLAY</button>
                    </div>
                </div>

            </div>


            <div class="game-card">

                <div class="game-image game-three">
                    <span>RACING</span>
                </div>

                <div class="game-info">
                    <h3>Velocity X</h3>
                    <p>Racing • Cars • Multiplayer</p>

                    <div class="game-bottom">
                        <span>⭐ 4.7</span>
                        <button>PLAY</button>
                    </div>
                </div>

            </div>


            <div class="game-card">

                <div class="game-image game-four">
                    <span>HORROR</span>
                </div>

                <div class="game-info">
                    <h3>Nightmare City</h3>
                    <p>Horror • Survival • Mystery</p>

                    <div class="game-bottom">
                        <span>⭐ 4.9</span>
                        <button>PLAY</button>
                    </div>
                </div>

            </div>

        </div>

    </section>


    <!-- ================= CATEGORIES ================= -->

    <section class="categories" id="categories">

        <div class="section-heading">
            <p>CHOOSE YOUR PLAYSTYLE</p>
            <h2>GAME <span>CATEGORIES</span></h2>
        </div>

        <div class="category-grid">

            <div class="category-card">
                <div class="category-icon">⚔️</div>
                <h3>Action</h3>
                <p>125 Games</p>
            </div>

            <div class="category-card">
                <div class="category-icon">🏎️</div>
                <h3>Racing</h3>
                <p>85 Games</p>
            </div>

            <div class="category-card">
                <div class="category-icon">🧙</div>
                <h3>RPG</h3>
                <p>140 Games</p>
            </div>

            <div class="category-card">
                <div class="category-icon">🔫</div>
                <h3>Shooting</h3>
                <p>190 Games</p>
            </div>

            <div class="category-card">
                <div class="category-icon">👻</div>
                <h3>Horror</h3>
                <p>65 Games</p>
            </div>

            <div class="category-card">
                <div class="category-icon">🏀</div>
                <h3>Sports</h3>
                <p>90 Games</p>
            </div>

        </div>

    </section>


    <!-- ================= ABOUT / FEATURES ================= -->

    <section class="features">

        <div class="feature-content">

            <p class="small-title">WHY GAMEZONE?</p>

            <h2>
                BUILT FOR
                <span>REAL GAMERS</span>
            </h2>

            <p>
                GameZone is designed for gamers who want more.
                Discover new games, compete with players around
                the world, participate in tournaments and become
                part of a massive gaming community.
            </p>

            <div class="feature-list">

                <div class="feature-item">
                    <strong>⚡</strong>
                    <div>
                        <h3>Fast Gaming</h3>
                        <p>Enjoy a smooth gaming experience.</p>
                    </div>
                </div>

                <div class="feature-item">
                    <strong>🏆</strong>
                    <div>
                        <h3>Competitive Tournaments</h3>
                        <p>Compete and prove your skills.</p>
                    </div>
                </div>

                <div class="feature-item">
                    <strong>🌎</strong>
                    <div>
                        <h3>Global Community</h3>
                        <p>Meet gamers from around the world.</p>
                    </div>
                </div>

            </div>

        </div>

        <div class="feature-box">

            <div class="big-controller">
                🎮
            </div>

            <h3>READY PLAYER?</h3>

            <p>
                Your next adventure is waiting.
            </p>

            <a href="#join" class="main-button">START PLAYING</a>

        </div>

    </section>


    <!-- ================= COMMUNITY ================= -->

    <section class="community" id="community">

        <div class="section-heading">
            <p>CONNECT • COMPETE • CONQUER</p>
            <h2>JOIN THE <span>COMMUNITY</span></h2>
        </div>

        <div class="community-content">

            <div class="community-card">
                <div class="community-number">01</div>
                <h3>Find Players</h3>
                <p>
                    Find players who share your interests
                    and create your perfect squad.
                </p>
            </div>

            <div class="community-card">
                <div class="community-number">02</div>
                <h3>Join Tournaments</h3>
                <p>
                    Participate in competitive tournaments
                    and win amazing rewards.
                </p>
            </div>

            <div class="community-card">
                <div class="community-number">03</div>
                <h3>Become a Legend</h3>
                <p>
                    Climb the leaderboard and become
                    one of the best players.
                </p>
            </div>

        </div>

    </section>


    <!-- ================= MEMBERSHIP ================= -->

    <section class="membership" id="membership">

        <div class="section-heading">
            <p>LEVEL UP YOUR EXPERIENCE</p>
            <h2>CHOOSE YOUR <span>PLAN</span></h2>
        </div>

        <div class="pricing-grid">

            <div class="price-card">

                <h3>ROOKIE</h3>

                <div class="price">
                    $0
                    <small>/month</small>
                </div>

                <ul>
                    <li>✓ Access to free games</li>
                    <li>✓ Community access</li>
                    <li>✓ Basic profile</li>
                    <li>✓ Weekly updates</li>
                </ul>

                <a href="#" class="price-button">GET STARTED</a>

            </div>


            <div class="price-card popular">

                <div class="popular-label">MOST POPULAR</div>

                <h3>PRO GAMER</h3>

                <div class="price">
                    $9.99
                    <small>/month</small>
