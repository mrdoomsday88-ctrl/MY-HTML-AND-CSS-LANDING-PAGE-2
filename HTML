                <ul>
                    <li>✓ Everything in Rookie</li>
                    <li>✓ Premium games</li>
                    <li>✓ Exclusive tournaments</li>
                    <li>✓ VIP profile badge</li>
                    <li>✓ Special rewards</li>
                </ul>

                <a href="#" class="price-button">GO PRO</a>

            </div>


            <div class="price-card">

                <h3>LEGEND</h3>

                <div class="price">
                    $19.99
                    <small>/month</small>
                </div>

                <ul>
                    <li>✓ Everything in Pro</li>
                    <li>✓ Unlimited games</li>
                    <li>✓ VIP tournaments</li>
                    <li>✓ Legendary profile</li>
                    <li>✓ Exclusive rewards</li>
                </ul>

                <a href="#" class="price-button">BECOME LEGEND</a>

            </div>

        </div>

    </section>


    <!-- ================= CTA ================= -->

    <section class="cta" id="join">

        <div class="cta-content">

            <p>YOUR NEXT ADVENTURE STARTS HERE</p>

            <h2>
                READY TO
                <span>PLAY?</span>
            </h2>

